# Copy to .env and adjust. Real environment variables override this file.
# All values shown are the defaults.

TRUSTDOC_DATA_DIR=data
# TRUSTDOC_DB_PATH=data/trustdoc.db
TRUSTDOC_LOG_LEVEL=INFO
TRUSTDOC_LOG_TO_FILE=true

# Chunking (used from Part 2)
TRUSTDOC_CHUNK_MAX_CHARS=1200
TRUSTDOC_CHUNK_OVERLAP_CHARS=150

# Retrieval (Part 3)
TRUSTDOC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRUSTDOC_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TRUSTDOC_CANDIDATE_K=20
TRUSTDOC_FINAL_K=5
TRUSTDOC_RRF_K=60
# 0.0 is an UNCALIBRATED placeholder; reranker score scales differ per model/version.
TRUSTDOC_RELEVANCE_THRESHOLD=0.0
TRUSTDOC_DEVICE=cpu
TRUSTDOC_EMBEDDING_BATCH_SIZE=32

# LLM for the Ask workflow (Part 4). Local and free: no API key is ever required.
#   none         -> no model configured (default). `ask` still answers "insufficient evidence"
#                   without a model, but cannot generate answers.
#   ollama       -> a local Ollama server (https://ollama.com). Run `ollama pull <model>` first.
#   transformers -> in-process Hugging Face model (needs torch + transformers, e.g. the
#                   `retrieval` extra). Downloads the model on first use unless cached.
#   stub         -> deterministic extractive stand-in (NOT a language model) for smoke tests.
TRUSTDOC_LLM_PROVIDER=none
# Example Ollama models (check `ollama list` / the Ollama library for current names and sizes):
#   TRUSTDOC_LLM_PROVIDER=ollama   TRUSTDOC_LLM_MODEL=qwen2.5:1.5b
TRUSTDOC_LLM_MODEL=
# Ollama server address (default http://localhost:11434). Only used by the ollama provider.
TRUSTDOC_LLM_BASE_URL=
# Unused by the local backends; kept for a future remote backend. Never put a key in this file.
TRUSTDOC_LLM_API_KEY_ENV=TRUSTDOC_LLM_API_KEY
TRUSTDOC_LLM_TEMPERATURE=0.0
# CPU generation is slow; raise this if you see timeouts.
TRUSTDOC_LLM_TIMEOUT_SECONDS=120
TRUSTDOC_LLM_MAX_TOKENS=512
TRUSTDOC_LLM_CONTEXT_TOKENS=4096

# Ask workflow limits
TRUSTDOC_ASK_MAX_EVIDENCE_ITEMS=5
TRUSTDOC_ASK_MAX_EVIDENCE_CHARS=6000
TRUSTDOC_ASK_MAX_QUESTION_CHARS=2000
